# CẤU HÌNH SUPABASE (TRẮC NGHIỆM THCS TÂY ĐÔ)
# Lấy từ Supabase Dashboard: Project Settings -> API
# Chỉ dùng Public/Anon Key phía Frontend, TUYỆT ĐỐI KHÔNG dùng service_role key ở đây!
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6..."

# Biến tương thích ngược nếu bạn sử dụng tên cũ VITE_SUPABASE_ANON_KEY:
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6..."

# CẤU HÌNH PHÍA SERVER (CHỈ DÙNG Ở SERVER, TUYỆT ĐỐI KHÔNG THÊM TIỀN TỐ VITE_)
# Dùng cho API /api/admin/* (tạo/mời tài khoản, phân quyền, gán lớp)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
PUBLIC_APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Tùy chọn cho trợ lý soạn đề
GEMINI_API_KEY=""
